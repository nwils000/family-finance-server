{
  "name": "@kk/site",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "sync:assets": "node scripts/sync-assets.mjs",
    "predev": "npm run sync:assets",
    "dev": "next dev -p 3100",
    "prebuild": "npm run sync:assets",
    "build": "next build",
    "postbuild": "node -e \"require('fs').rmSync('.next', { recursive: true, force: true })\" && node scripts/check-bundle.mjs",
    "start": "node scripts/serve.mjs",
    "check:layout": "node scripts/check-layout.mjs",
    "typecheck": "tsc --noEmit",
    "og": "node scripts/generate-og-image.mjs"
  },
  "dependencies": {
    "@fontsource/fredoka": "^5.1.1",
    "@fontsource/nunito": "^5.1.1",
    "@kk/shared": "1.0.0",
    "framer-motion": "^11.18.0",
    "next": "14.2.35",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "autoprefixer": "^10.4.20",
    "playwright-core": "1.60.0",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
