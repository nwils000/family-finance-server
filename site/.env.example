# Where the Kid Kapital web app lives. CTA buttons go to `${APP_URL}/signup`,
# `${APP_URL}/login` and `${APP_URL}/kid-login`; legal pages link to its /privacy and /terms.
NEXT_PUBLIC_APP_URL=http://localhost:5173

# This site's own public origin. Used for canonical URLs, the sitemap, robots.txt
# and Open Graph tags. Set it in production (the build warns when it is missing).
NEXT_PUBLIC_SITE_URL=http://localhost:3100
