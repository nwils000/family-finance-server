MONGO_URL=mongodb://127.0.0.1:27017/kid-kapital
JWT_SECRET=change-me-to-a-long-random-string
PORT=8787
CLIENT_ORIGINS=http://localhost:5173,capacitor://localhost,http://localhost
# Which environment this is: production, staging, development or test. Anything else
# (or unset) counts as HOSTED: secure cookies, HSTS, no dev endpoints, and the boot
# refuses a JWT_SECRET under 32 random characters. `npm run dev` sets development.
# NODE_ENV=production
# The demo-family quick login (the Dev button). Only with NODE_ENV=development AND
# this set to true AND a caller on this machine. `npm run dev` sets it.
# ENABLE_DEV_ENDPOINTS=true
# Where email links and Stripe redirects point (defaults to the first CLIENT_ORIGINS entry).
APP_URL=
# One JSON line per request (path, status, ms, user id). Set to false to silence.
LOG_REQUESTS=true

# --- Everything below is optional. Each feature stays off until its keys are set. ---

# Email (password reset, email verification). Without it, dev prints the links to this console.
SMTP_URL=
MAIL_FROM=Kid Kapital <hello@kidkapital.app>

# Google sign-in for grown-ups (Google Cloud console OAuth client ids).
GOOGLE_CLIENT_ID=
GOOGLE_IOS_CLIENT_ID=
GOOGLE_ANDROID_CLIENT_ID=

# Sign in with Apple: APPLE_CLIENT_ID is the iOS bundle id, APPLE_SERVICES_ID the web Services ID.
APPLE_CLIENT_ID=
APPLE_SERVICES_ID=
APPLE_WEB_REDIRECT_URI=
