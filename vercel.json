{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npm ci",
  "buildCommand": "node scripts/vercel-build.mjs",
  "ignoreCommand": "[ -n \"$VERCEL_GIT_COMMIT_REF\" ] && { [ \"$VERCEL_GIT_COMMIT_REF\" != rebuild ] || git diff --quiet ${VERCEL_GIT_PREVIOUS_SHA:-HEAD^} HEAD -- . ':(exclude)site' ':(exclude)docs' ; }",
  "outputDirectory": "client/dist"
}
