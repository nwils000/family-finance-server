{
  "name": "kid-kapital",
  "private": true,
  "version": "1.0.0",
  "workspaces": [
    "shared",
    "server",
    "client",
    "site"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c magenta,cyan \"npm run dev -w server\" \"npm run dev -w client\"",
    "build": "npm run build -w client",
    "test": "npm test -w server",
    "typecheck": "npm run typecheck -w server && npm run typecheck -w client",
    "seed": "npm run seed -w server",
    "dev:site": "npm run dev -w site",
    "build:site": "npm run build -w site"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "engines": {
    "node": ">=20"
  }
}
